# Copy to .env for local use, or set these in your host's dashboard.
ECOMSIM_DB=/var/data/game.db          # must be on a PERSISTENT disk
ECOMSIM_SECRET=                        # long random string; keeps sessions alive
ECOMSIM_BEHIND_PROXY=1                 # set when a host terminates HTTPS for you
ECOMSIM_NAME=E-Commerce in Practice
ECOMSIM_TEAMS=8
ECOMSIM_ROUNDS=12
ECOMSIM_PRESET=advanced
ECOMSIM_ADMIN_PASSWORD=                # first boot only; change it in the app after
